{
  "grammars": [
    {
      "name": "kotlin",
      "camelcase": "Kotlin",
      "scope": "source.kotlin",
      "path": ".",
      "file-types": [
        "kt",
        "kts"
      ],
      "highlights": "queries/highlights.scm",
      "tags": "queries/tags.scm"
    }
  ],
  "metadata": {
    "version": "0.4.3",
    "license": "MIT",
    "description": "Brokk-maintained Tree-sitter grammar for Kotlin",
    "authors": [
      {
        "name": "fwcd"
      },
      {
        "name": "Brokk"
      }
    ],
    "links": {
      "repository": "git+https://github.com/BrokkAi/tree-sitter-kotlin.git"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
